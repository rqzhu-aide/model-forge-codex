   "required": true,
   "requirement": "always"
  },
  {
   "output_id": "p1.coverage_candidate",
   "output_kind": "scientific_record",
   "producer": "research_lead",
   "schema_application": "object",
   "schema_uri": "architecture/schemas/scientific-record.schema.json",
   "purpose": "Record current search coverage, exclusions, and unresolved gaps.",
   "required": true,
   "requirement": "always"
  },
  {
   "output_id": "p1.phase2_handoff",
   "output_kind": "handoff",
   "producer": "research_lead",
   "schema_application": "object",
   "schema_uri": "architecture/schemas/handoff.schema.json",
   "purpose": "State the literature basis, conflicts, and open methodological questions for Phase 2.",
   "required": true,
   "requirement": "always"
  }
 ],
 "validation_rules": [
  {
   "validator_id": "p1.role_sequence",
   "category": "run_boundary",
   "severity": "blocking",
   "description": "All independent reports and the later lead synthesis exist in the declared order and remain run-local."
  },
  {
   "validator_id": "p1.source_identity",
   "category": "provenance",
   "severity": "blocking",
   "description": "Each source has a stable identity, citation metadata, search provenance, and no duplicate identity."
  },
  {
   "validator_id": "p1.synthesis_traceability",
   "category": "scientific_completeness",
   "severity": "blocking",
   "description": "Material synthesis statements cite promoted sources or explicitly mark missing or unresolved evidence."
  },
  {
   "validator_id": "p1.atomic_publication",
   "category": "promotion_safety",
   "severity": "blocking",
   "description": "The library update and synthesis replacement commit together or not at all."
  }
 ],
