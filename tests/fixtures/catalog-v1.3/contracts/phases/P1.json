  }
 ],
 "promotion": {
  "strategy": "append_merge",
  "canonical_record_types": [
   "literature_library",
   "literature_synthesis",
   "literature_coverage",
   "phase_decision"
  ],
  "cumulative_object_types": [
   "literature_source",
   "attention_item"
  ],
  "blocking_validator_ids": [
   "p1.role_sequence",
   "p1.source_identity",
   "p1.synthesis_traceability",
   "p1.atomic_publication"
  ],
  "failure_behavior": "Keep the prior library and synthesis current; retain the candidate only in its run workspace.",
  "atomic": true
 },
 "downstream_effects": [
  {
   "trigger": "new_current_record",
   "affected_phases": [
    "P2",
    "P3",
    "P4",
    "P5"
   ],
   "description": "New literature creates targeted research attention where it bears on a method, claim, evidence interpretation, or manuscript statement. It does not create exact-method misalignment.",
   "automatic_run": false,
   "alignment_effect": {
    "action": "preserve"
   },
   "attention_effect": {
    "action": "record_if_identified"
   }
  }
 ],
 "ui_projection": {
  "researcher_questions": [
   "What new evidence was found?",
   "What changed in the synthesis?",
   "What remains weakly covered or disputed?",
   "What can I run next?"
  ],
  "fields": [
   {
    "field_id": "p1.new_sources",
