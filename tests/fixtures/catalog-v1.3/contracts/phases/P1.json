{
 "phase_id": "P1",
 "contract_version": "2.4.0",
 "prose_contract": "architecture/phases/phase-1.md",
 "name": "Literature basis",
 "scientific_purpose": "Maintain a cumulative, deduplicated literature corpus and a replaceable synthesis of what is known, disputed, and missing for the project question.",
 "current_record_semantics": {
  "strategy": "cumulative_append",
  "canonical_record_types": [
   "literature_library",
   "literature_synthesis",
   "literature_coverage",
   "phase_decision"
  ],
  "research_meaning": "The current basis combines every valid unique source with the latest integrated account of coverage, evidence, disagreement, and gaps.",
  "history_policy": "Earlier syntheses remain historical. Current sources and synthesis are the default basis; prior records enter only when the user selects them."
 },
 "user_choices": [
  {
   "choice_id": "p1.scope",
   "label": "Search scope",
   "description": "Choose a broad update or a focused question.",
   "required": true,
   "allowed_values": [
    "broad_update",
    "focused_update"
   ],
   "value_kind": "enum_string"
  },
  {
   "choice_id": "p1.instructions",
   "label": "Research instructions",
   "description": "State the scientific question, emphasis, exclusions, and source constraints.",
   "required": true,
   "allowed_values": [],
   "value_kind": "text"
  },
  {
   "choice_id": "p1.selected_history",
   "label": "Selected history",
   "description": "Optionally add named historical records for a specific research question.",
   "required": false,
   "allowed_values": [],
   "value_kind": "artifact_pointer_list"
  }
 ],
 "run_modes": [
  {
   "mode_id": "p1.literature_update",
   "label": "Literature update",
   "purpose": "Discover sources, update provenance, assess coverage, and replace the current synthesis.",
   "requires_method": false,
   "entry_conditions": [
    "A formal current project brief is readable."
   ],
   "required_choice_ids": [
    "p1.scope",
    "p1.instructions"
   ],
   "optional_choice_ids": [
    "p1.selected_history"
   ]
  }
 ],
 "prerequisites": [
  {
   "requirement_id": "p1.current_project_brief",
   "kind": "phase_record",
   "description": "A formal current project brief states the scientific problem and scope.",
   "required": true
  }
 ],
 "required_inputs": [
  {
   "input_id": "p1.project_brief",
   "record_type": "project_brief",
   "publication_required": "formal",
   "position_required": "current",
   "method_match": "not_applicable",
   "purpose": "Fix the project question and scope.",
   "condition": "Always required.",
   "presence": "always"
  },
  {
   "input_id": "p1.current_library",
   "record_type": "literature_library",
   "publication_required": "formal",
   "position_required": "current",
   "method_match": "not_applicable",
   "purpose": "Prevent duplicate source identities and preserve cumulative provenance.",
   "condition": "Required on reruns and absent on the first run.",
   "presence": "required_on_rerun"
  },
  {
   "input_id": "p1.current_synthesis",
   "record_type": "literature_synthesis",
   "publication_required": "formal",
   "position_required": "current",
   "method_match": "not_applicable",
   "purpose": "Identify what the new run must revise or extend.",
   "condition": "Required on reruns and absent on the first run.",
   "presence": "required_on_rerun"
  },
  {
   "input_id": "p1.current_coverage",
   "record_type": "literature_coverage",
   "publication_required": "formal",
   "position_required": "current",
   "method_match": "not_applicable",
   "purpose": "Identify covered questions, stated exclusions, and unresolved search gaps.",
   "condition": "Required on reruns and absent on the first run.",
   "presence": "required_on_rerun"
  }
 ],
 "supplementary_inputs": [
  {
   "input_id": "p1.researcher_material",
   "record_type": "researcher_material",
   "purpose": "Accept researcher-supplied material (for example the researcher's own paper) as additional context for building the literature basis. It is additive only and never substitutes for published literature records; a researcher paper enters the pipeline here, at Phase 1."
  }
 ],
 "prepared_contexts": [],
 "optional_context_policy": {
  "default": "current_only",
  "allows_selected_history": true,
  "history_selection_user_controlled": true,
  "description": "Only current formal records are loaded by default. Historical records enter only through explicit user selection.",
  "history_choice_id": "p1.selected_history"
 },
 "role_stages": [
  {
   "sequence": 1,
   "stage_id": "p1.discovery",
   "applicable_modes": [
    "p1.literature_update"
   ],
   "execution": "parallel",
   "roles": [
    "research_lead",
    "theorist",
    "data_analyst"
   ],
   "objective": "Search and assess the same frozen question from scientific, mathematical, and empirical perspectives.",
   "reads": [
    "p1.project_brief",
    "p1.current_library",
    "p1.current_synthesis",
    "p1.current_coverage"
   ],
   "writes": [
    "p1.lead_discovery",
    "p1.theory_discovery",
    "p1.empirical_discovery",
    "p1.lead_paper_cards",
    "p1.theory_paper_cards",
    "p1.empirical_paper_cards"
   ],
   "handoff_required": true,
   "isolation_rule": "Discovery roles do not read one another's current-run reports before submission.",
   "artifact_contracts": {
    "p1.lead_discovery": {
     "artifact_type": "t2p_packet",
     "audience": [
      "research_lead",
      "theorist",
      "data_analyst"
     ],
     "delivery": "inline"
    },
    "p1.theory_discovery": {
     "artifact_type": "t2p_packet",
     "audience": [
      "research_lead",
      "data_analyst"
     ],
     "delivery": "inline"
    },
    "p1.empirical_discovery": {
     "artifact_type": "t2p_packet",
     "audience": [
      "research_lead",
      "theorist"
     ],
     "delivery": "inline"
    },
    "p1.lead_paper_cards": {
     "artifact_type": "t1_card",
     "audience": [
      "user"
     ],
     "delivery": "ui_only"
    },
    "p1.theory_paper_cards": {
     "artifact_type": "t1_card",
     "audience": [
      "user"
     ],
     "delivery": "ui_only"
    },
    "p1.empirical_paper_cards": {
     "artifact_type": "t1_card",
     "audience": [
      "user"
     ],
     "delivery": "ui_only"
    }
   }
  },
  {
   "sequence": 2,
   "stage_id": "p1.lead_synthesis",
   "applicable_modes": [
    "p1.literature_update"
   ],
   "execution": "serial",
   "roles": [
    "research_lead"
   ],
   "objective": "Deduplicate sources, reconcile or expose disagreements, assess coverage, and produce the candidate current basis.",
   "reads": [
    "p1.project_brief",
    "p1.current_library",
    "p1.current_synthesis",
    "p1.current_coverage",
    "p1.lead_discovery",
    "p1.theory_discovery",
    "p1.empirical_discovery"
   ],
   "writes": [
    "p1.source_changes",
    "p1.synthesis_compact",
    "p1.synthesis_candidate",
    "p1.coverage_candidate",
    "p1.phase2_handoff",
    "p1.attention_items",
    "p1.decision",
    "p1.phase_summary"
   ],
   "handoff_required": true,
   "artifact_contracts": {
    "p1.source_changes": {
     "artifact_type": "t3m_manuscript",
     "audience": [
      "research_lead"
     ],
     "delivery": "mention"
    },
    "p1.synthesis_candidate": {
     "artifact_type": "t3m_manuscript",
     "audience": [
      "p5"
     ],
     "delivery": "mention"
    },
    "p1.synthesis_compact": {
     "artifact_type": "t2p_packet",
     "audience": [
      "theorist",
      "data_analyst",
      "p5"
     ],
     "delivery": "inline"
    },
    "p1.coverage_candidate": {
     "artifact_type": "record",
     "audience": [
      "research_lead"
     ],
     "delivery": "mention"
    },
    "p1.phase2_handoff": {
     "artifact_type": "t2p_packet",
     "audience": [
      "theorist",
      "data_analyst"
     ],
     "delivery": "inline"
    },
    "p1.phase_summary": {
     "artifact_type": "t2s_summary",
     "audience": [
      "research_lead",
      "theorist",
      "data_analyst",
      "user"
     ],
     "delivery": "inline"
    },
    "p1.attention_items": {
     "artifact_type": "record",
     "audience": [
      "research_lead",
      "p5"
     ],
     "delivery": "mention"
    },
    "p1.decision": {
     "artifact_type": "record",
     "audience": [
      "research_lead",
      "theorist",
      "data_analyst",
      "p5",
      "user"
     ],
     "delivery": "inline"
    }
   }
  }
 ],
 "run_local_outputs": [
  {
   "output_id": "p1.lead_discovery",
   "output_kind": "handoff",
   "producer": "research_lead",
   "schema_application": "object",
   "schema_uri": "architecture/schemas/handoff.schema.json",
   "purpose": "Preserve the lead's independent search and substantive assessment.",
   "required": true,
   "requirement": "always"
  },
  {
   "output_id": "p1.theory_discovery",
   "output_kind": "handoff",
   "producer": "theorist",
   "schema_application": "object",
   "schema_uri": "architecture/schemas/handoff.schema.json",
   "purpose": "Preserve mathematical foundations, related methods, assumptions, and limits.",
   "required": true,
   "requirement": "always"
  },
  {
   "output_id": "p1.empirical_discovery",
   "output_kind": "handoff",
   "producer": "data_analyst",
   "schema_application": "object",
   "schema_uri": "architecture/schemas/handoff.schema.json",
   "purpose": "Preserve study-design, data, computation, evaluation, and reproducibility findings.",
   "required": true,
   "requirement": "always"
  },
  {
   "output_id": "p1.source_changes",
   "output_kind": "scientific_record",
   "producer": "research_lead",
   "schema_application": "each_item",
   "schema_uri": "architecture/schemas/literature-source.schema.json",
   "purpose": "Record unique sources, corrections, and additional discovery provenance.",
   "required": true,
   "requirement": "always"
  },
  {
   "output_id": "p1.synthesis_compact",
   "output_kind": "synthesis",
   "producer": "research_lead",
   "schema_application": "object",
   "schema_uri": "architecture/schemas/compact-view.schema.json",
   "purpose": "Provide the layer-3 compact decision view of the synthesis: 1-2 decision-oriented paragraphs for downstream stages and the researcher.",
   "required": true,
   "requirement": "always"
  },
  {
   "output_id": "p1.synthesis_candidate",
   "output_kind": "synthesis",
   "producer": "research_lead",
   "schema_application": "object",
   "schema_uri": "architecture/schemas/scientific-record.schema.json",
   "purpose": "Provide the complete candidate synthesis of evidence, disagreement, and gaps.",
   "required": true,
   "requirement": "always"
  },
  {
   "output_id": "p1.attention_items",
   "output_kind": "attention_item_set",
   "producer": "research_lead",
   "schema_application": "each_item",
   "schema_uri": "architecture/schemas/attention-item.schema.json",
