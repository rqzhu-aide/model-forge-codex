{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://model-forge.local/architecture/schemas/traceability-registry.schema.json",
  "title": "Architecture Traceability Registry",
  "description": "Machine-readable links among system invariants, research-workflow requirements, implementation test groups, acceptance scenarios, phase contracts, and roadmap milestones.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "invariant_coverage",
    "scenarios"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common-definitions.schema.json#/$defs/schemaVersion"
    },
    "invariant_coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/invariantCoverage"
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenarioRegistration"
      }
    }
  },
  "$defs": {
    "invariantId": {
      "type": "string",
      "pattern": "^INV-[0-9]{3}$"
    },
    "requirementId": {
      "type": "string",
      "pattern": "^MF-[0-9]{2}$"
    },
    "testId": {
      "type": "string",
      "pattern": "^IT-[0-9]{3}$"
    },
    "scenarioId": {
      "type": "string",
      "pattern": "^s[0-9]{2}\\.[a-z0-9_]+$"
    },
    "invariantCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invariant_id",
        "requirement_ids",
        "test_ids",
        "scenario_ids"
      ],
      "properties": {
        "invariant_id": {
          "$ref": "#/$defs/invariantId"
        },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/requirementId"
          }
        },
        "test_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/testId"
          }
        },
        "scenario_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/scenarioId"
          }
        }
      }
    },
    "scenarioRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id",
        "scenario_code",
        "document",
        "phase_contracts",
        "milestones",
        "invariant_ids",
        "requirement_ids",
        "test_ids"
      ],
      "properties": {
        "scenario_id": {
          "$ref": "#/$defs/scenarioId"
        },
        "scenario_code": {
          "type": "string",
          "pattern": "^S[0-9]{2}$"
        },
        "document": {
          "type": "string",
          "pattern": "^architecture/design/scenarios/S[0-9]{2}-[A-Za-z0-9-]+\\.md$"
        },
        "phase_contracts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["P1", "P2", "P3", "P4", "P5"]
          }
        },
        "milestones": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^M[0-9]+$"
          }
        },
        "invariant_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/invariantId"
          }
        },
        "requirement_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/requirementId"
          }
        },
        "test_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/testId"
          }
        }
      }
    }
  }
}
