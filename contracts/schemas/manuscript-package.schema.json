{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://model-forge.local/architecture/schemas/manuscript-package.schema.json",
  "title": "Phase 5 Manuscript Package",
  "description": "A complete P5 manuscript record that points to the actual readable manuscript artifact and classifies its central claims by upstream support phase.",
  "allOf": [
    {
      "$ref": "scientific-record.schema.json"
    },
    {
      "type": "object",
      "required": [
        "title",
        "manuscript_kind",
        "target_audience",
        "manuscript_artifact",
        "sections_present",
        "claim_support_index"
      ],
      "properties": {
        "record_type": {
          "const": "manuscript"
        },
        "phase": {
          "const": "P5"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "manuscript_kind": {
          "type": "string",
          "enum": ["assembly_candidate", "revised_candidate"]
        },
        "target_audience": {
          "type": "string",
          "minLength": 1
        },
        "venue_length": {
          "type": "string",
          "enum": ["journal", "conference"],
          "description": "The genre frozen in the producing run's project venue_length. Required for candidates under the adopted P5 frozen-review-instructions capability; optional when reading legacy records, whose unrecorded original scope remains unavailable. This genre does not establish a page quota or a verified rendered length."
        },
        "manuscript_artifact": {
          "$ref": "common-definitions.schema.json#/$defs/artifactPointer"
        },
        "sections_present": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "abstract",
              "introduction",
              "method",
              "theory",
              "experiments",
              "discussion",
              "limitations",
              "references",
              "appendix",
              "supplement"
            ]
          },
          "allOf": [
            {"contains": {"const": "abstract"}},
            {"contains": {"const": "introduction"}},
            {"contains": {"const": "method"}},
            {"contains": {"const": "theory"}},
            {"contains": {"const": "experiments"}},
            {"contains": {"const": "discussion"}},
            {"contains": {"const": "limitations"}},
            {"contains": {"const": "references"}}
          ]
        },
        "claim_support_index": {
          "description": "Navigation groups for declared manuscript claim IDs. These do not replace the separately authored claim_traceability entries containing readable claims and exact support, counterevidence and unresolved sources.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "p1_literature_claim_ids",
            "p2_method_claim_ids",
            "p3_theory_claim_ids",
            "p4_empirical_claim_ids",
            "interpretation_claim_ids"
          ],
          "properties": {
            "p1_literature_claim_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common-definitions.schema.json#/$defs/stableId"
              },
              "uniqueItems": true
            },
            "p2_method_claim_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common-definitions.schema.json#/$defs/stableId"
              },
              "uniqueItems": true
            },
            "p3_theory_claim_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common-definitions.schema.json#/$defs/stableId"
              },
              "uniqueItems": true
            },
            "p4_empirical_claim_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "common-definitions.schema.json#/$defs/stableId"
              },
              "uniqueItems": true
            },
            "interpretation_claim_ids": {
              "type": "array",
              "items": {
                "$ref": "common-definitions.schema.json#/$defs/stableId"
              },
              "uniqueItems": true
            }
          }
        },
        "supplementary_artifacts": {
          "type": "array",
          "items": {
            "$ref": "common-definitions.schema.json#/$defs/artifactPointer"
          }
        },
        "representations": {
          "contains": {
            "type": "object",
            "properties": {
              "information_layer": {
                "const": "primary_artifact"
              }
            },
            "required": ["information_layer", "artifact"]
          },
          "minContains": 1
        }
      }
    }
  ]
}
