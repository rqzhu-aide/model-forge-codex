{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://model-forge.local/architecture/schemas/command-error.schema.json",
  "title": "Command Error",
  "description": "Stable researcher-facing failure envelope shared by Web and remote command clients.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "error_id",
    "code",
    "category",
    "http_status",
    "retryable",
    "rule_id",
    "object_refs",
    "researcher_message",
    "smallest_correction",
    "occurred_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "common-definitions.schema.json#/$defs/schemaVersion"
    },
    "error_id": {
      "$ref": "common-definitions.schema.json#/$defs/stableId"
    },
    "code": {
      "type": "string",
      "enum": [
        "AUTHENTICATION_REQUIRED",
        "DELEGATION_NOT_ACTIVE",
        "COMMAND_SCHEMA_INVALID",
        "COMMAND_DIGEST_MISMATCH",
        "IDEMPOTENCY_KEY_REUSED",
        "INVALID_TRANSITION",
        "RUN_ALREADY_SUBMITTED",
        "CANCELLATION_REQUESTED",
        "CONTROL_HEAD_STALE",
        "STALE_BASIS",
        "TARGET_STATE_MISMATCH",
        "TARGET_NOT_FOUND",
        "DEPENDENCY_CLOSURE_INCOMPLETE",
        "NO_STATE_CHANGE",
        "PUBLICATION_CONFLICT",
        "CUSTOMIZATION_CONFLICT",
        "ROLE_PROVISIONING_FAILED",
        "SUPERVISED_RUN_INVALID",
        "SUPERVISED_RUN_LOCKED",
        "SUPERVISED_RUN_PREFLIGHT_FAILED",
        "CORRECTION_NOT_APPLICABLE",
        "CORRECTION_SCOPE_INVALID",
        "CORRECTION_EXHAUSTED"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "authentication",
        "authorization",
        "schema",
        "digest",
        "idempotency",
        "transition",
        "concurrency",
        "dependency"
      ]
    },
    "http_status": {
      "type": "integer",
      "enum": [
        400,
        401,
        403,
        404,
        409,
        422,
        500
      ]
    },
    "retryable": {
      "type": "boolean"
    },
    "rule_id": {
      "type": "string",
      "pattern": "^MF-[0-9]{2}$"
    },
    "object_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "field_path": {
      "type": "string",
      "minLength": 1
    },
    "researcher_message": {
      "type": "string",
      "minLength": 1
    },
    "smallest_correction": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "detail": {
      "type": "object",
      "description": "Optional structured payload carried by selected error codes (for example the supervised-run preflight report). Never contains secret material."
    }
  },
